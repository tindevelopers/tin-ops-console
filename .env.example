# Neon Auth (Managed Better Auth) for the tin-ops-console project. Copy to .env.local.
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
# At least 32 characters. Generate: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
NEON_AUTH_COOKIE_SECRET=
# Read-only connection string for the console_reader role (status store). Optional: pages show a notice when unset.
CONSOLE_DATABASE_URL=
# Connection string for the console_admin role (registry writes). Server-only; never prefix with NEXT_PUBLIC_.
# Without it the registry is read-only and the admin forms are hidden.
CONSOLE_ADMIN_DATABASE_URL=
